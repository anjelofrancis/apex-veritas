NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/apex_veritas?schema=public"

# JWT
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_PLAN_STARTER=PLN_xxx
PAYSTACK_PLAN_PROFESSIONAL=PLN_xxx
PAYSTACK_PLAN_ENTERPRISE=PLN_xxx

# Twilio (WhatsApp alerts)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_PHONE=whatsapp:+14155238886

# AWS S3 (document storage)
S3_BUCKET=apex-veritas-documents
S3_REGION=eu-west-1
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx

# CORS — comma-separated list of allowed origins
# Local dev:
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Production example:
# CORS_ORIGINS=http://apex-veritas-portal.s3-website-us-east-1.amazonaws.com,http://apex-veritas.s3-website-us-east-1.amazonaws.com
